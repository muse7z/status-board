+// A "plugin" window hosts a plugin-contributed route full-bleed (e.g. the
+// status-board floating overlay): full app renderer with its own gateway and
+// plugin door, but the shell renders only the route table — no sidebar, no
+// titlebar clusters — so the plugin page owns the whole window.
+let pluginOverlayWindowCache: boolean | null = null
+
+export function isPluginOverlayWindow(): boolean {
+  if (pluginOverlayWindowCache !== null) {
+    return pluginOverlayWindowCache
+  }
+
+  let result = false
+
+  try {
+    result = new URLSearchParams(window.location.search).get('win') === 'plugin'
+  } catch {
+    result = false
+  }
+
+  pluginOverlayWindowCache = result
+
+  return result
+}
+
